# Normalise line endings so a Windows checkout and a Linux/macOS one don't
# produce whitespace-only diffs against each other. Without this, cloning on
# Windows with core.autocrlf=true rewrites every file on checkout and git
# reports "LF will be replaced by CRLF" on every add.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.apk binary
*.jar binary
*.keystore binary

# Gradle wrapper: the shell script must stay LF, the batch file CRLF.
gradlew text eol=lf
gradlew.bat text eol=crlf
