<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- This app IS the launcher: it needs the leanback feature, not touch. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Android 11+ package visibility: without this <queries> block,
        PackageManager.queryIntentActivities() for CATEGORY_LEANBACK_LAUNCHER
        returns an empty list and the launcher has nothing to show.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- So the "Google TV Home" escape-hatch tile can find the stock
             launcher to hand off to, instead of just re-opening us. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- So the "Google Play Store" system-row tile can find and launch it. -->
        <package android:name="com.android.vending" />
    </queries>

    <!--
        S31 — the home handoff at cold boot does not reliably land on us even
        though we hold android.app.role.HOME AND the user-0 preferred activity
        for CATEGORY_HOME. See BootReceiver: we start ourselves after boot
        instead of relying on the system to pick us.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        S32 — BAL EXEMPTION. S31's receiver ran correctly and was refused:
          W ActivityTaskManager: Background activity launch blocked
            [callingPackage: com.wmc.mediacenter; callingUidProcState: RECEIVER;
             backgroundStartPrivileges: allowsBackgroundActivityStarts=false]
          E ActivityTaskManager: Abort background activity starts from 10120

        Holding android.app.role.HOME did NOT exempt us. Holding
        SYSTEM_ALERT_WINDOW is a documented exemption from the background
        activity launch restriction, so we declare it purely for that — the app
        draws no overlays.

        DECLARING IT IS NOT ENOUGH. It's an appop, off by default, and there is
        usually no way to enable it from the Google TV settings UI. Grant it
        once per device:

          adb shell appops set com.wmc.mediacenter SYSTEM_ALERT_WINDOW allow

        It survives reboots. It does NOT survive an uninstall.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        T2 — backup & restore reads/writes a fixed public path
        (/sdcard/MCLauncher/mclauncher-backup.json) so the backup SURVIVES AN
        UNINSTALL — the app-private external dir is wiped with the package,
        which would defeat the point. On Android 11+ a fixed public path
        requires "All files access"; like SYSTEM_ALERT_WINDOW above it must be
        granted once per device over adb (no Google TV settings UI for it):

          adb shell appops set com.wmc.mediacenter MANAGE_EXTERNAL_STORAGE allow

        Survives reboots, NOT uninstalls — after reinstalling, re-grant BEFORE
        restoring. Ungranted, backup/restore fail with an on-screen message
        that includes this command; nothing else in the app touches storage.
        WRITE_EXTERNAL_STORAGE covers the same feature on Android 10 and below.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        S36 — OPTIONAL, and the app works without it. Declaring it costs
        nothing: its protectionLevel is signature|privileged|development, so
        it can never be granted by installing the app, only deliberately over
        adb.

          adb shell pm grant com.wmc.mediacenter android.permission.WRITE_SECURE_SETTINGS

        With it, the "Photo wall screensaver" toggle can select the dream
        itself by writing Settings.Secure.screensaver_components — which is
        the ONLY way to select it at all on Google TV, whose Ambient mode
        source list never shows third-party dreams (NOTES.md section 9). One
        one-time grant replaces having to re-run adb every time the setting is
        toggled.

        Without it the toggle still works, it just can't finish the job: the
        dream becomes available and MCLauncher shows the manual commands
        instead. See ScreensaverSelection.

        Survives reboots. Does NOT survive an uninstall.

        tools:ignore="ProtectedPermissions" — lint flags this as an error
        because a normal app can never be GRANTED it at install time. That is
        true, and it is the entire point: the grant is a deliberate one-time
        adb command (see above), never something installing the app can
        acquire. ScreensaverSelection checks checkSelfPermission before every
        use and degrades to "show the manual instructions" when it is absent,
        so the ungranted case is the supported default rather than a broken
        state. Suppressed here, at the single line it applies to, rather than
        with a project-wide lint rule.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MCLauncher"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.MCLauncher">

            <!-- Makes this app selectable as the device's Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Separate filter so the launcher is also reachable as a normal
                 leanback app (e.g. from Settings > Apps), independent of the
                 HOME filter above. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            S31 — exported=true is REQUIRED: BOOT_COMPLETED is a protected
            system broadcast and an unexported manifest receiver will never be
            delivered it. This receiver is otherwise inert; it responds to
            nothing else.
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            S33 — wake-from-sleep watchdog; see HomeWatchdogService for the
            full story. Inert until the service is enabled in accessibility
            settings (one adb command, in INSTALL.md).
        -->
        <service
            android:name=".HomeWatchdogService"
            android:exported="true"
            android:label="@string/watchdog_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_watchdog_config" />
        </service>

        <!--
            S35 — WMC-style photo wall screensaver, as a real Android TV
            screensaver (Daydream). See PhotoWallDreamService for the full
            story. exported=true is required (targetSdk 34 mandates an
            explicit value on any component with an intent-filter) and safe:
            BIND_DREAM_SERVICE is a signature permission, so only the system
            can actually bind — same shape as HomeWatchdogService above.
            Selected by the user in Settings > Device Preferences > Screen
            saver; no adb grant needed for that step. Registration fails
            SILENTLY if this entry or the meta-data resource is wrong — the
            dream just never appears in the picker, nothing in logcat points
            at it.
        -->
        <!--
            S36 — enabled="false" is deliberate: MCLauncher must not put
            itself in the system's screensaver list, let alone change what
            the user already has selected, just because it was installed.
            The user opts in from MCLauncher Settings > "Photo wall
            screensaver", which flips this component on via
            ScreensaverAvailability and then explains that Android still
            needs them to pick it. COMPONENT_ENABLED_STATE_DEFAULT therefore
            means DISABLED for this component — see that file's isEnabled().
        -->
        <service
            android:name=".screensaver.PhotoWallDreamService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/photo_wall_dream" />
        </service>

    </application>

</manifest>
