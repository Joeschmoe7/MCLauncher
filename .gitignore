# Build output
# NOTE: "build/" not "/build" — the old pattern was root-anchored and therefore
# missed app/build/, which is where nearly all the output actually lands.
build/
*.iml
.externalNativeBuild
.cxx
/captures

# Tooling / machine-specific
.gradle/
.kotlin/
/.idea
local.properties
.DS_Store

# Diagnostics — screen captures and artwork dumps used while investigating
# rendering and frame timing (see NOTES.md §7). Useful to produce, never to commit.
*.mp4
/art/
/home.png

# Local Claude Code tooling config — machine-specific absolute paths, not project config.
.claude/

# Private working notes. LAUNCHER_PLAYBOOK.md is kept outside this repo on purpose
# (it was purged from history); this guard exists so copying it back in for a build
# can't silently republish it.
LAUNCHER_PLAYBOOK.md
